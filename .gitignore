# ---------------------------------------------------------------------------
# Part 6: model exports and weights
# ---------------------------------------------------------------------------
# The full gpt2 exports are ~950 MB each; only the stripped snapshot
# (gpt2_linalg_stripped.mlir) is checked in. Regenerate the full files with
# part6-end-to-end-ml/generate_snapshots.sh.
part6-end-to-end-ml/src/gpt2/gpt2_torch.mlir
part6-end-to-end-ml/src/gpt2/gpt2_linalg.mlir
